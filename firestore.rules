rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Meetings Collection
    // Secured by 'userId' field on the document
    match /meetings/{meetingId} {
      // Read: Allow if the existing doc belongs to the user
      allow read: if isOwner(resource.data.userId);
      
      // Create: Allow if the new doc claims to belong to the user
      allow create: if isOwner(request.resource.data.userId) 
                    && request.resource.data.clientName.size() > 0; // Basic validation
      
      // Update/Delete: Allow if the existing doc belongs to the user
      allow update, delete: if isOwner(resource.data.userId);
    }
  }
}
