rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if authenticated (including Firebase Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Access Keys Collection (Checked during PIN login)
    match /access_keys/{keyId} {
      // Allow read so users can verify PIN on login
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Clients Directory
    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Meetings Collection
    match /meetings/{meetingId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Over-The-Air (OTA) Releases Subsystem
    match /ota_releases/{releaseId} {
      // Public read so the app can check for updates on startup & foreground
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Dynamic Remote Configuration & Announcements
    match /app_config/{configId} {
      // Public read so the app can render remote banners and dynamic lists
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
